# Ustawienia dla serwera Apache. Na innych serwerach ten plik jest ignorowany.
#
# Każdy blok jest owinięty w IfModule: jeśli serwer nie ma danego modułu,
# reguła po prostu nie zadziała, zamiast wywrócić całą stronę błędem 500.

# Starsze wersje Apache nie znają rozszerzenia .webmanifest.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_headers.c>
  # Pliki z odciskiem treści w nazwie — nowa wersja to nowa nazwa,
  # więc stary plik może leżeć w pamięci przeglądarki rok.
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Wejście, worker i manifest muszą być sprawdzane za każdym razem.
  # Zapamiętane na dłużej trzymałyby użytkownika przy starej wersji.
  <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
